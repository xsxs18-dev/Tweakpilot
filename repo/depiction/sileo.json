{
  "minVersion": "0.1",
  "class": "DepictionTabView",
  "tintColor": "#5E5CE6",
  "tabs": [
    {
      "tabname": "Details",
      "class": "DepictionStackView",
      "views": [
        {
          "class": "DepictionMarkdownView",
          "markdown": "Something acting weird and no idea which tweak did it? Tweakpilot puts a little bubble on your screen. Tap it and you see every tweak you have installed. Tap one to turn it off, tap again to turn it back on. Nothing gets uninstalled.\n\nYou also get live RAM, CPU and battery, plus Respring and Restart Injection buttons right there."
        },
        {
          "class": "DepictionScreenshotsView",
          "itemCornerRadius": 12,
          "itemSize": "{160, 346}",
          "screenshots": [
            { "url": "https://xsxs18-dev.github.io/Tweakpilot/screenshots/panel.jpg", "accessibilityText": "Tweak list" },
            { "url": "https://xsxs18-dev.github.io/Tweakpilot/screenshots/actions.jpg", "accessibilityText": "Stats and quick actions" },
            { "url": "https://xsxs18-dev.github.io/Tweakpilot/screenshots/bubble.jpg", "accessibilityText": "Floating bubble" }
          ]
        },
        {
          "class": "DepictionMarkdownView",
          "markdown": "- pinch the panel to make it bigger or smaller\n- drag the bubble anywhere, it snaps to the edge\n- hidden on the lock screen\n- Liquid Glass look on iOS 26"
        },
        { "class": "DepictionSeparatorView" },
        { "class": "DepictionTableTextView", "title": "Version", "text": "@VERSION@" },
        { "class": "DepictionTableTextView", "title": "Compatibility", "text": "iOS 15 and newer" },
        { "class": "DepictionTableTextView", "title": "Jailbreak", "text": "roothide and rootless" },
        { "class": "DepictionTableTextView", "title": "Developer", "text": "xsxs18" },
        {
          "class": "DepictionTableButtonView",
          "title": "Source code",
          "action": "https://github.com/xsxs18-dev/Tweakpilot"
        },
        {
          "class": "DepictionTableButtonView",
          "title": "Report a bug",
          "action": "https://github.com/xsxs18-dev/Tweakpilot/issues"
        }
      ]
    },
    {
      "tabname": "Changelog",
      "class": "DepictionStackView",
      "views": [
        {
          "class": "DepictionMarkdownView",
          "markdown": "@CHANGELOG@"
        }
      ]
    }
  ]
}
